# Base URL of the GraphGuard AI backend API.
# The frontend appends the API prefix (default: /api/v1) to this value.
# Do not put secrets here. This is a public, client-side variable.
# Primary variable (used in production, e.g. Vercel):
VITE_API_URL=https://falkordb-tfuk.onrender.com
# Legacy alias (still supported as a fallback):
# VITE_API_BASE_URL=http://localhost:8000
