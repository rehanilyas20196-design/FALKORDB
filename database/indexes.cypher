
/*
 GraphGuard AI
 File: database/indexes.cypher
 Database: FalkorDB

 Purpose:
 Improve query performance for security events,
 entities, alerts, investigations, and attack paths.
*/

////////////////////////////////////////////////////////////////////////
// 1. User indexes
////////////////////////////////////////////////////////////////////////

CREATE INDEX FOR (u:User) ON (u.id);
CREATE INDEX FOR (u:User) ON (u.name);
CREATE INDEX FOR (u:User) ON (u.email);

////////////////////////////////////////////////////////////////////////
// 2. Device indexes
////////////////////////////////////////////////////////////////////////

CREATE INDEX FOR (d:Device) ON (d.id);
CREATE INDEX FOR (d:Device) ON (d.hostname);

////////////////////////////////////////////////////////////////////////
// 3. IP address indexes
////////////////////////////////////////////////////////////////////////

CREATE INDEX FOR (ip:IP) ON (ip.address);

////////////////////////////////////////////////////////////////////////
// 4. Security event indexes
////////////////////////////////////////////////////////////////////////

CREATE INDEX FOR (e:Event) ON (e.id);
CREATE INDEX FOR (e:Event) ON (e.event_type);
CREATE INDEX FOR (e:Event) ON (e.timestamp);
CREATE INDEX FOR (e:Event) ON (e.source);
CREATE INDEX FOR (e:Event) ON (e.severity);

////////////////////////////////////////////////////////////////////////
// 5. Alert indexes
////////////////////////////////////////////////////////////////////////

CREATE INDEX FOR (a:Alert) ON (a.id);
CREATE INDEX FOR (a:Alert) ON (a.severity);
CREATE INDEX FOR (a:Alert) ON (a.status);
CREATE INDEX FOR (a:Alert) ON (a.created_at);

////////////////////////////////////////////////////////////////////////
// 6. Investigation indexes
////////////////////////////////////////////////////////////////////////

CREATE INDEX FOR (i:Investigation) ON (i.id);
CREATE INDEX FOR (i:Investigation) ON (i.status);

////////////////////////////////////////////////////////////////////////
// 7. Attack path indexes
////////////////////////////////////////////////////////////////////////

CREATE INDEX FOR (p:AttackPath) ON (p.id);
CREATE INDEX FOR (p:AttackPath) ON (p.risk_score);

////////////////////////////////////////////////////////////////////////
// 8. Process indexes
////////////////////////////////////////////////////////////////////////

CREATE INDEX FOR (p:Process) ON (p.id);
CREATE INDEX FOR (p:Process) ON (p.name);

////////////////////////////////////////////////////////////////////////
// 9. File indexes
////////////////////////////////////////////////////////////////////////

CREATE INDEX FOR (f:File) ON (f.id);
CREATE INDEX FOR (f:File) ON (f.path);

////////////////////////////////////////////////////////////////////////
// 10. Network connection indexes
////////////////////////////////////////////////////////////////////////

CREATE INDEX FOR (n:NetworkConnection) ON (n.id);
CREATE INDEX FOR (n:NetworkConnection) ON (n.protocol);
